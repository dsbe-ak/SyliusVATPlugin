{% extends '@GewebeSyliusVATPlugin/shop/shared/address/vat_number.html.twig' %}

{% block validation_status %}
    {% set status = gewebe_sylius_vat_validation_status(address) %}

    {% if status is not null %}
        {% set status_configuration = {
            valid: {
                class: 'text-success',
                icon: 'tabler:circle-check',
                label: 'gewebe_sylius_vat_plugin.ui.vat_number_is_valid',
            },
            invalid: {
                class: 'text-danger',
                icon: 'tabler:circle-x',
                label: 'gewebe_sylius_vat_plugin.ui.vat_number_is_invalid',
            },
            expired: {
                class: 'text-warning',
                icon: 'tabler:clock-exclamation',
                label: 'gewebe_sylius_vat_plugin.ui.vat_number_validation_expired',
            },
            not_validated: {
                class: 'text-secondary',
                icon: 'tabler:help-circle',
                label: 'gewebe_sylius_vat_plugin.ui.vat_number_not_validated_yet',
            },
        } %}
        {% set configuration = status_configuration[status] %}
        {% set label = configuration.label|trans %}
        {% set tooltip = label %}
        {% if address.vatValidatedAt is not null %}
            {% set tooltip = tooltip ~ ' · ' ~ (address.vatValidatedAt|format_date) %}
        {% endif %}

        <span
            class="address-vat-validation-status {{ configuration.class }}"
            title="{{ tooltip }}"
            aria-label="{{ tooltip }}"
            {{ sylius_test_html_attribute('vat-validation-status', status) }}
        >
            {{ ux_icon(configuration.icon, { class: 'icon icon-xs' }) }}
        </span>
    {% endif %}
{% endblock %}
